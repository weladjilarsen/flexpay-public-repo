# ════════════════════════════════════════════════════════════════════════
# systemd template — kubectl port-forward persistant pour FlexPay
#
# Rend les microservices Minikube accessibles sur la VM (0.0.0.0)
# pour l'accès externe via navigateur.
#
# Usage :
#   systemctl enable --now flexpay-port-forward@admin-server
#   systemctl enable --now flexpay-port-forward@gateway
#   systemctl enable --now flexpay-port-forward@user-service
#   systemctl enable --now flexpay-port-forward@kyc-service
#   systemctl enable --now flexpay-port-forward@messaging-service
#   systemctl enable --now flexpay-port-forward@admin-service
# ════════════════════════════════════════════════════════════════════════

[Unit]
Description=FlexPay port-forward — %i
After=network.target
Wants=network.target

[Service]
Type=simple
EnvironmentFile=/etc/flexpay/port-forward/%i.conf
ExecStart=/usr/local/bin/kubectl port-forward \
    svc/${SVC_NAME} ${LOCAL_PORT}:${REMOTE_PORT} \
    -n ${NAMESPACE} \
    --address=0.0.0.0 \
    --kubeconfig=${KUBECONFIG_PATH}
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
