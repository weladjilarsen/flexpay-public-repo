# ════════════════════════════════════════════════════════════════════════
# .env — Variables pour docker-compose.yml + JCasC
#
# OPTION 1 (automatique) : ./setup.sh remplit les valeurs auto-detectees
# OPTION 2 (manuel)      : cp .env.example .env && nano .env
#
# NE JAMAIS COMMITTER .env DANS GIT
# ════════════════════════════════════════════════════════════════════════

# ── IP de la VM Ubuntu ────────────────────────────────────────────────
# OBLIGATOIRE — Minikube et Jenkins utilisent cette IP pour le registry.
# Si Tailscale est installe : tailscale ip -4
# Sinon : hostname -I | awk '{print $1}'
HOST_IP=

# ── Jenkins ───────────────────────────────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=

# ── GitHub ────────────────────────────────────────────────────────────
GITHUB_USER=weladjilarsen
GITHUB_TOKEN=
GITHUB_ORG=weladjilarsen

# ── Admin Server (Spring Security du microservice) ───────────────────
# Utilise par le JCasC (credential admin-server-credentials)
# et par le K8s secret (ADMIN_USERNAME / ADMIN_PASSWORD dans le pod)
ADMIN_SERVER_USERNAME=admin
ADMIN_SERVER_PASSWORD=

# ── Kubernetes / Minikube ─────────────────────────────────────────────
# Rempli automatiquement par setup.sh
KUBECONFIG_PATH=
KUBECONFIG_BASE64=

# ── Notifications ─────────────────────────────────────────────────────
EMAIL_RECIPIENTS=weladjilarsen@outlook.com
