# ════════════════════════════════════════════════════════════════════════
# .env — Variables pour docker-compose.yml
#
# OPTION 1 (automatique) : ./setup.sh remplit les valeurs auto-détectées
# OPTION 2 (manuel)      : cp .env.example .env && nano .env
#
# NE JAMAIS COMMITTER .env DANS GIT
# ════════════════════════════════════════════════════════════════════════

# ── IP de la VM Ubuntu ────────────────────────────────────────────────
# OBLIGATOIRE — Minikube utilise cette IP pour accéder au registry.
# Obtenir avec : hostname -I | awk '{print $1}'
HOST_IP=

# ── Jenkins ───────────────────────────────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=

# ── GitHub ────────────────────────────────────────────────────────────
GITHUB_USER=weladjilarsen
GITHUB_TOKEN=
GITHUB_ORG=weladjilarsen

# ── Admin Server (Spring Security) ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Kubernetes / Minikube ─────────────────────────────────────────────
# Rempli automatiquement par setup.sh
KUBECONFIG_PATH=
KUBECONFIG_BASE64=

# ── Notifications ─────────────────────────────────────────────────────
EMAIL_RECIPIENTS=weladjilarsen@outlook.com
