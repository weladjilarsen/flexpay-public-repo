// ════════════════════════════════════════════════════════════════════════
// Jenkinsfile — flexpay-admin-server-service
//
// Architecture :
//   - VM Ubuntu avec Docker Engine
//   - Jenkins tourne comme container Docker (docker.sock monté)
//   - Registry Docker local sur la VM (localhost:5000, sans auth)
//   - Kubernetes (même VM) gère les pods du microservice
//
// Pipeline : Checkout → Build → Test → Package → Docker → K8s Deploy
// ════════════════════════════════════════════════════════════════════════

pipeline {
    agent any

    environment {
        APP_NAME      = 'flexpay-admin-server'
        // L'IP de la VM hôte (pas localhost) car Minikube tourne dans
        // un container Docker et ne partage pas le localhost de la VM.
        // Détecté automatiquement par setup.sh ou à définir manuellement.
        REGISTRY_URL  = "${env.HOST_IP ? env.HOST_IP + ':5000' : 'localhost:5000'}"
        IMAGE_NAME    = "${REGISTRY_URL}/${APP_NAME}"
        IMAGE_TAG     = "${env.BRANCH_NAME == 'main' ? env.BUILD_NUMBER : env.BRANCH_NAME + '-' + env.BUILD_NUMBER}"
        K8S_NAMESPACE = "${env.BRANCH_NAME == 'main' ? 'flexpay-prod' : 'flexpay-staging'}"
        KUBECONFIG    = credentials('kubeconfig-file')
    }

    tools {
        maven 'maven-3.9'
        jdk   'jdk-21'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(false)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        // ─────────────── 1. CHECKOUT ──────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    env.GIT_AUTHOR = sh(
                        script: 'git log -1 --pretty=format:"%an"',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        // ─────────────── 2. COMPILATION ───────────────────────────────
        stage('Build') {
            steps {
                sh 'mvn clean compile -B -q'
            }
        }

        // ─────────────── 3. TESTS UNITAIRES ───────────────────────────
        stage('Unit Tests') {
            steps {
                sh 'mvn test -B'
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml',
                         allowEmptyResults: true
                    jacoco(
                        execPattern: '**/target/jacoco.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java'
                    )
                }
            }
        }

        // ─────────────── 4. PACKAGE ──────────────────────────────────
        stage('Package') {
            steps {
                sh 'mvn package -DskipTests -B -q'
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }

        // ─────────────── 5. SCAN SÉCURITÉ DÉPENDANCES ────────────────
        stage('Dependency Check') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                dependencyCheck(
                    additionalArguments: '''
                        --scan target/
                        --format HTML
                        --format JSON
                        --failOnCVSS 7
                    ''',
                    odcInstallation: 'dependency-check'
                )
            }
            post {
                always {
                    dependencyCheckPublisher pattern: 'dependency-check-report.json'
                }
            }
        }

        // ─────────────── 6. BUILD IMAGE DOCKER ────────────────────────
        stage('Docker Build') {
            steps {
                sh """
                    docker build \
                      --label "org.opencontainers.image.revision=${GIT_COMMIT_SHORT}" \
                      --label "org.opencontainers.image.created=\$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                      --label "org.opencontainers.image.version=${IMAGE_TAG}" \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${IMAGE_NAME}:latest \
                      .
                """
            }
        }

        // ─────────────── 7. SCAN VULNÉRABILITÉS IMAGE ─────────────────
        stage('Image Security Scan') {
            steps {
                sh """
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      aquasec/trivy:latest image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      --ignore-unfixed \
                      --format table \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        // ─────────────── 8. PUSH VERS REGISTRY LOCAL ──────────────────
        // Registry local (localhost:5000) — pas d'authentification
        stage('Docker Push') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                sh """
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                """
            }
        }

        // ─────────────── 9. DEPLOY SUR KUBERNETES ─────────────────────
        stage('Deploy to Kubernetes') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                sh """
                    kubectl --kubeconfig=\${KUBECONFIG} create namespace ${K8S_NAMESPACE} \
                      --dry-run=client -o yaml | \
                      kubectl --kubeconfig=\${KUBECONFIG} apply -f -

                    kubectl --kubeconfig=\${KUBECONFIG} apply -f k8s/ -n ${K8S_NAMESPACE}

                    kubectl --kubeconfig=\${KUBECONFIG} set image deployment/${APP_NAME} \
                      ${APP_NAME}=${IMAGE_NAME}:${IMAGE_TAG} \
                      -n ${K8S_NAMESPACE}

                    kubectl --kubeconfig=\${KUBECONFIG} rollout status deployment/${APP_NAME} \
                      -n ${K8S_NAMESPACE} \
                      --timeout=300s
                """
            }
        }

        // ─────────────── 10. SMOKE TEST ───────────────────────────────
        stage('Smoke Test') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                sh """
                    NODE_PORT=\$(kubectl --kubeconfig=\${KUBECONFIG} get svc ${APP_NAME} \
                      -n ${K8S_NAMESPACE} \
                      -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "9090")

                    for i in \$(seq 1 12); do
                        HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                          "http://localhost:\${NODE_PORT}/actuator/health" || true)
                        if [ "\$HTTP_CODE" = "200" ]; then
                            echo "Smoke test PASSED — /actuator/health returned 200"
                            exit 0
                        fi
                        echo "Attempt \$i/12 — got \$HTTP_CODE, retrying in 10s..."
                        sleep 10
                    done
                    echo "Smoke test FAILED after 12 attempts"
                    kubectl --kubeconfig=\${KUBECONFIG} logs deployment/${APP_NAME} \
                      -n ${K8S_NAMESPACE} --tail=50
                    exit 1
                """
            }
        }
    }

    // ════════════════════════ POST-ACTIONS ════════════════════════════════
    post {
        success {
            emailext(
                to: '${DEFAULT_RECIPIENTS}',
                subject: "SUCCESS: ${APP_NAME} #${env.BUILD_NUMBER}",
                body: """
                    Build ${APP_NAME} #${env.BUILD_NUMBER} — SUCCESS
                    Branch: ${env.BRANCH_NAME} | Commit: ${env.GIT_COMMIT_SHORT}
                    Author: ${env.GIT_AUTHOR}
                    Image: ${IMAGE_NAME}:${IMAGE_TAG}
                    Namespace: ${K8S_NAMESPACE}
                    ${env.BUILD_URL}
                """.stripIndent()
            )
        }
        failure {
            emailext(
                to: '${DEFAULT_RECIPIENTS}',
                subject: "FAILED: ${APP_NAME} #${env.BUILD_NUMBER}",
                body: """
                    Build ${APP_NAME} #${env.BUILD_NUMBER} — FAILED
                    Branch: ${env.BRANCH_NAME} | Commit: ${env.GIT_COMMIT_SHORT}
                    Author: ${env.GIT_AUTHOR}
                    Logs: ${env.BUILD_URL}console
                """.stripIndent()
            )
        }
        always {
            cleanWs()
        }
    }
}
